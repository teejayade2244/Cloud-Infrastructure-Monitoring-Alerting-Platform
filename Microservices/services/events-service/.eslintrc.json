{
    "root": true,
    "env": {
        "node": true,
        "commonjs": true,
        "es2021": true,
        "jest": true
    },
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "script"
    },
    "extends": ["eslint:recommended"],
    "ignorePatterns": ["node_modules/", "coverage/"],
    "rules": {
        "no-unused-vars": ["warn", { "args": "none" }]
    }
}
