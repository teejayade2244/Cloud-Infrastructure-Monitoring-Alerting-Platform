{
    "name": "events-service",
    "version": "1.0.0",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:integration": "jest --config jest.integration.config.js",
        "lint": "eslint .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@azure/cosmos": "^4.0.0",
        "@azure/identity": "^4.0.0",
        "@azure/service-bus": "^7.9.0",
        "applicationinsights": "^3.15.1",
        "dotenv": "^17.4.2",
        "express": "^4.18.2",
        "uuid": "^9.0.0"
    },
    "devDependencies": {
        "eslint": "^8.57.1",
        "jest": "^30.4.2",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2"
    },
    "overrides": {
        "fast-xml-parser": "^5.10.1",
        "@opentelemetry/propagator-jaeger": "^2.9.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testPathIgnorePatterns": [
            "/node_modules/",
            "<rootDir>/__tests__/integration/"
        ],
        "collectCoverageFrom": [
            "src/routes/**/*.js",
            "src/middleware/**/*.js",
            "src/azureConfig.js"
        ],
        "coverageThreshold": {
            "global": {
                "statements": 70,
                "branches": 70,
                "functions": 70,
                "lines": 70
            }
        }
    }
}
